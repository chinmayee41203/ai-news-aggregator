# Copy this file to .env and fill in the values. Never commit .env.

# --- Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check the current Flash model name in AI Studio
GEMINI_MODEL=gemini-2.5-flash
# Used when the main model keeps failing (it has its own free quota)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- The Guardian Open Platform (free) — https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# --- YouTube Data API v3 (free) — Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=

# --- Email — the digest is sent to (and from) this address
MY_EMAIL=
# gmail_api (default) | gmail | brevo
# gmail_api: one-time sign-in with `uv run python scripts/gmail_authorize.py`
#            (needs credentials/client_secret.json from Google Cloud; token saved in credentials/)
EMAIL_PROVIDER=gmail_api
# Only for EMAIL_PROVIDER=gmail:
#   GMAIL_SENDER       the Gmail account that sends (can differ from MY_EMAIL; defaults to MY_EMAIL)
#   GMAIL_APP_PASSWORD that account's 16-letter app password — never a normal Google password
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# Only for EMAIL_PROVIDER=brevo: brevo.com → SMTP & API → API keys; verify MY_EMAIL under Senders
BREVO_API_KEY=

# --- Database (used from Phase 2)
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_news_aggregator
